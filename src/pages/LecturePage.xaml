<Page
    x:Class="LiveCaptionsTranslator.LecturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="LecturePage"
    JournalEntry.KeepAlive="False"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="14,10,14,12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,8,0,4" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,6,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
        <Grid Margin="15,12,5,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Left column: input, model / API  -->
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="⓪ 输入源" />

                        <TextBlock Style="{StaticResource Label}" Text="语音识别方式" />
                        <ComboBox x:Name="EngineBox" SelectionChanged="EngineBox_SelectionChanged">
                            <ComboBoxItem Content="Windows 系统实时字幕（免费）" />
                            <ComboBoxItem Content="阿里云实时语音识别（更准，按时长收费）" />
                        </ComboBox>

                        <StackPanel x:Name="AliyunPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Label}" Text="阿里云百炼 API Key" />
                            <PasswordBox x:Name="AsrKeyBox" PasswordChanged="AsrKeyBox_PasswordChanged" />
                            <TextBlock x:Name="AsrKeyStatus" Style="{StaticResource Hint}" />
                            <TextBlock Style="{StaticResource Hint}" Text="在阿里云百炼控制台（bailian.console.aliyun.com）开通后创建 API Key。如果 ① 里用的是通义千问，可以填同一个 Key。" />

                            <TextBlock Style="{StaticResource Label}" Text="老师讲课的语言" />
                            <ComboBox SelectedValue="{Binding AsrLanguage, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="英语" Tag="en" />
                                <ComboBoxItem Content="中文" Tag="zh" />
                                <ComboBoxItem Content="日语" Tag="ja" />
                                <ComboBoxItem Content="韩语" Tag="ko" />
                                <ComboBoxItem Content="德语" Tag="de" />
                                <ComboBoxItem Content="法语" Tag="fr" />
                                <ComboBoxItem Content="俄语" Tag="ru" />
                                <ComboBoxItem Content="粤语" Tag="yue" />
                                <ComboBoxItem Content="自动判断" Tag="" />
                            </ComboBox>

                            <Expander Margin="0,8,0,0" Header="高级：模型和接口地址">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource Label}" Text="识别模型" />
                                    <ComboBox x:Name="AsrModelBox" IsEditable="True" ItemsSource="{Binding AsrModels}"
                                              Text="{Binding AsrModel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <ui:Button Click="DeleteAsrModel_click" Content="删除模型" />
                                        <ui:Button Margin="5,0,0,0" Click="MoveAsrModelUp_click" Content="⬆" />
                                        <ui:Button Margin="5,0,0,0" Click="MoveAsrModelDown_click" Content="⬇" />
                                        <ui:Button Margin="10,0,0,0" Click="OpenAsrQuota_click" Content="查看百炼用量" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="接口地址" />
                                    <ui:TextBox x:Name="AsrEndpointBox" Text="{Binding AsrEndpoint, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="国内账号保持默认；国际站账号改成 wss://dashscope-intl.aliyuncs.com/api-ws/v1/inference。" />
                                </StackPanel>
                            </Expander>

                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <ui:Button
                                    x:Name="TestAsrButton"
                                    Click="TestAsr_click"
                                    Content="测试连接" />
                                <TextBlock
                                    x:Name="TestAsrResult"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Label}" Text="听哪里的声音" />
                        <ComboBox x:Name="SourceBox" SelectionChanged="SourceBox_SelectionChanged">
                            <ComboBoxItem Content="电脑播放的声音（网课、视频）" />
                            <ComboBoxItem Content="麦克风（线下教室）" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource Label}" Text="麦克风" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox
                                x:Name="MicBox"
                                MinWidth="230"
                                SelectionChanged="MicBox_SelectionChanged" />
                            <ui:Button
                                Margin="6,0,0,0"
                                Click="RefreshDevices_click"
                                Icon="{ui:SymbolIcon ArrowClockwise12,
                                                     Filled=False}"
                                ToolTip="刷新设备列表" />
                        </StackPanel>
                        <TextBlock x:Name="SourceStatus" Style="{StaticResource Hint}" />
                        <TextBlock Style="{StaticResource Hint}" Text="选择麦克风会把它设为 Windows 默认录音设备，并重启实时字幕。不要选蓝牙耳机自带的麦克风，否则耳机会切换到通话模式，音质变差。" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <ui:Button
                                x:Name="LiveCaptionsButton"
                                Click="LiveCaptionsButton_click"
                                Content="显示系统实时辅助字幕"
                                Icon="{ui:SymbolIcon ClosedCaption16,
                                                     Filled=False}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="用来检查系统字幕有没有出字、修改源语言或首次下载语音识别文件。用完点“隐藏”，不要直接关掉它。" />
                    </StackPanel>
                </Border>

                <Border x:Name="ApiCard" Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="① 模型与 API" />

                        <TextBlock Style="{StaticResource Label}" Text="服务商" />
                        <ComboBox x:Name="ProviderBox" SelectionChanged="ProviderBox_SelectionChanged"
                                  DropDownOpened="ProviderBox_DropDownOpened" DropDownClosed="ProviderBox_DropDownClosed">
                            <ComboBoxItem Content="DeepSeek" />
                            <ComboBoxItem Content="通义千问（阿里云百炼）" />
                            <ComboBoxItem Content="其他 OpenAI 兼容接口" />
                        </ComboBox>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <ui:Button Click="SaveApiConfig_click" Content="保存此次配置并命名" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Label}" Text="API 地址" />
                        <ui:TextBox
                            x:Name="ApiUrlBox"
                            PlaceholderText="https://…/chat/completions"
                            Text="{Binding ApiUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Style="{StaticResource Label}" Text="API Key" />
                        <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged" />
                        <TextBlock x:Name="ApiKeyStatus" Style="{StaticResource Hint}" />

                        <TextBlock Style="{StaticResource Label}" Text="模型（可从列表选，也可以直接输入）" />
                        <ComboBox
                            x:Name="ModelBox"
                            IsEditable="True"
                            Text="{Binding ModelName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        <Expander Margin="0,8,0,0" Header="高级：接口协议">
                            <StackPanel>
                                <ComboBox SelectedValuePath="Tag"
                                          SelectedValue="{Binding ApiStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="标准 OpenAI 兼容协议" Tag="standard" />
                                    <ComboBoxItem Content="Qwen-MT 翻译专用协议" Tag="qwen-mt" />
                                </ComboBox>
                                <TextBlock Style="{StaticResource Hint}" Text="普通对话模型保持标准协议。只有接口文档明确要求翻译专用协议时才切换。" />
                            </StackPanel>
                        </Expander>

                        <TextBlock Style="{StaticResource Label}" Text="摘要模型档位" />
                        <ComboBox
                            x:Name="SummaryConfigBox"
                            SelectionChanged="SummaryConfigBox_SelectionChanged" />
                        <TextBlock Style="{StaticResource Hint}" Text="小结、课堂纪要和“测试连接”都用这个档位的模型。字幕翻译用哪个档位在“⑤ 翻译”里选；翻译专用配置不能做摘要，请为摘要选择支持对话的模型。" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <ui:Button
                                x:Name="TestApiButton"
                                Click="TestApi_click"
                                Content="测试连接"
                                Icon="{ui:SymbolIcon PlugConnected20,
                                                     Filled=False}" />
                        </StackPanel>
                        <TextBlock x:Name="TestApiResult" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Right column: slides, sections, speech  -->
            <StackPanel Grid.Row="0" Grid.Column="1">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="② 课件（可选）" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                x:Name="LoadSlidesButton"
                                Click="LoadSlides_click"
                                Content="上传课件 PDF"
                                Icon="{ui:SymbolIcon DocumentPdf16,
                                                     Filled=False}" />
                            <ui:Button
                                x:Name="ClearSlidesButton"
                                Margin="6,0,0,0"
                                Click="ClearSlides_click"
                                Content="移除"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock
                            x:Name="SlidesInfo"
                            Margin="2,8,0,0"
                            TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Label}" Text="扫描版课件的 OCR 语言" />
                        <ComboBox x:Name="OcrLanguageBox" SelectionChanged="OcrLanguageBox_SelectionChanged" />
                        <ui:ToggleSwitch
                            Margin="0,8,0,0"
                            Content="所有页面都用 OCR（文字乱码时打开）"
                            IsChecked="{Binding ForceOcr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Style="{StaticResource Hint}"
                            Text="上传后按老师讲到的页码分节，小结也会参考这一页的文字纠正术语。没有文字的页面（扫描件、图片）会自动用 Windows 自带的 OCR 识别；OCR 语言来自 Windows 已安装的语言包。也支持 .pptx。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="③ 分节总结" />
                        <ui:ToggleSwitch
                            Content="自动分节并总结"
                            IsChecked="{Binding SummaryEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource Label}" Text="分节方式" />
                        <ComboBox SelectedIndex="{Binding SegmentModeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="自动：按课件页码 / 话题变化" />
                            <ComboBoxItem Content="固定按时间" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource Label}" ToolTip="自动模式下，同一话题讲了这么久也会强制分一节">
                            <Run Text="每节最长：" />
                            <Run Text="{Binding MaxSectionMinutes, Mode=OneWay}" />
                            <Run Text="分钟" />
                        </TextBlock>
                        <Slider
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            IsSnapToTickEnabled="True"
                            Maximum="20"
                            Minimum="2"
                            TickFrequency="1"
                            Value="{Binding MaxSectionMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource Label}" ToolTip="固定按时间模式，或自动识别失败时使用">
                            <Run Text="按时间分节：每" />
                            <Run Text="{Binding SummaryIntervalMinutes, Mode=OneWay}" />
                            <Run Text="分钟一节" />
                        </TextBlock>
                        <Slider
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            IsSnapToTickEnabled="True"
                            Maximum="15"
                            Minimum="1"
                            TickFrequency="1"
                            Value="{Binding SummaryIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Hint}" Text="随时按 Ctrl+Alt+S 可手动结束本节。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="④ 耳机播报" />

                        <TextBlock Style="{StaticResource Label}" Text="读出内容" />
                        <ComboBox SelectedIndex="{Binding SpeakModeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="关闭" />
                            <ComboBoxItem Content="只读小节总结" />
                            <ComboBoxItem Content="小节总结 + 每句译文" />
                            <ComboBoxItem Content="实时同传：每句中文译文马上读（不读总结）" />
                        </ComboBox>
                        <TextBlock Style="{StaticResource Hint}" Text="实时同传会把每句译文一出来就读给你听，读不过来时跳过积压的旧句子，保证跟得上老师。" />

                        <TextBlock Style="{StaticResource Label}" Text="输出设备" />
                        <ComboBox x:Name="SpeechDeviceBox" SelectionChanged="SpeechDeviceBox_SelectionChanged" />
                        <TextBlock x:Name="SpeechDeviceHint" Style="{StaticResource Hint}" />

                        <TextBlock Style="{StaticResource Label}" Text="语音" />
                        <ComboBox x:Name="VoiceBox" SelectionChanged="VoiceBox_SelectionChanged" />

                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="语速：" />
                            <Run Text="{Binding SpeechRate, Mode=OneWay}" />
                        </TextBlock>
                        <Slider
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            IsSnapToTickEnabled="True"
                            Maximum="10"
                            Minimum="-5"
                            TickFrequency="1"
                            Value="{Binding SpeechRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="音量：" />
                            <Run Text="{Binding SpeechVolume, Mode=OneWay}" />
                        </TextBlock>
                        <Slider
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            IsSnapToTickEnabled="True"
                            Maximum="100"
                            Minimum="10"
                            TickFrequency="5"
                            Value="{Binding SpeechVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <ui:Button
                                Click="TestSpeech_click"
                                Content="试听"
                                Icon="{ui:SymbolIcon Play16,
                                                     Filled=False}" />
                            <ui:Button
                                Margin="6,0,0,0"
                                Click="SoundSettings_click"
                                Content="选择输出设备…"
                                Icon="{ui:SymbolIcon Speaker216,
                                                     Filled=False}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="标题栏的“耳机播报”开关或 Ctrl+Alt+M 可以随时打开 / 关闭。" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Full width: translation  -->
            <Border
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="⑤ 翻译" />

                        <TextBlock Style="{StaticResource Label}" Text="这门课的学科 / 主题" />
                        <ui:TextBox
                            PlaceholderText="例如：基因治疗、分子生物学、宏观经济学"
                            Text="{Binding Subject, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Style="{StaticResource Hint}" Text="填了之后，翻译和小结会按这个学科的术语来，例如 vector 译成“载体”而不是“向量”。也会写进课件识别和小结里。" />

                        <TextBlock Style="{StaticResource Label}" Text="术语表（每行一个，可写成“术语 = 译法”）" />
                        <ui:TextBox
                            x:Name="GlossaryBox"
                            MinHeight="90"
                            MaxHeight="200"
                            AcceptsReturn="True"
                            PlaceholderText="例如：&#x0a;adeno-associated virus = 腺相关病毒&#x0a;CRISPR&#x0a;vector = 载体"
                            Text="{Binding Glossary, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <ui:Button
                                x:Name="ExtractGlossaryButton"
                                Click="ExtractGlossary_click"
                                Content="从课件提取术语"
                                Icon="{ui:SymbolIcon TextBulletListAdd20,
                                                     Filled=False}" />
                            <TextBlock
                                x:Name="GlossaryResult"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource Hint}"
                            Text="用阿里云识别时，术语会作为热词提高识别率。翻译接口选 DeepSeek / 通义千问时，翻译、精修、小结和笔记都会按这里的译法统一（选 Google 翻译时，实时翻译和精修用不上术语表，只有小结和笔记会用）。换课时记得换成这门课的术语。" />

                        <TextBlock Style="{StaticResource Label}" Text="翻译接口" />
                        <ComboBox
                            x:Name="TranslateApiBox"
                            DisplayMemberPath="Name"
                            SelectionChanged="TranslateApiBox_SelectionChanged" />
                        <TextBlock Style="{StaticResource Hint}" Text="选 DeepSeek / 通义千问时使用“① 模型与 API”的设置；Google 免费，不用 Key。" />

                        <TextBlock Style="{StaticResource Label}" Text="翻译成" />
                        <ComboBox
                            x:Name="TargetLangBox"
                            IsEditable="True"
                            LostFocus="TargetLangBox_LostFocus"
                            SelectionChanged="TargetLangBox_SelectionChanged" />
                        <TextBlock Style="{StaticResource Hint}" Text="可以直接输入语言代码，例如 zh-CN、en-US。" />

                        <ui:Button
                            Margin="0,10,0,0"
                            Click="APISettingButton_click"
                            Content="其他接口的配置…"
                            Icon="{ui:SymbolIcon Settings16,
                                                 Filled=False}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <ui:ToggleSwitch
                            Margin="0,34,0,0"
                            Content="纯英文模式"
                            IsChecked="{Binding EnglishOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Hint}" Text="不翻译，只显示英文原文；小节总结、段落精修（只纠错不翻译）、笔记初稿和语音播报都用英文。适合想直接练英文听课的时候。" />

                        <ui:ToggleSwitch
                            Margin="0,12,0,0"
                            Content="只转录，不翻译"
                            IsChecked="{Binding CaptionsOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Hint}" Text="只显示听写出来的原文，不调用翻译接口（小节总结仍然会做）。" />

                        <ui:ToggleSwitch
                            Margin="0,12,0,0"
                            Content="段落精修（推荐）"
                            IsChecked="{Binding RefineParagraphs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Style="{StaticResource Hint}"
                            Text="每说完几句，用 DeepSeek 结合上下文、课程主题和课件把这几句整理成一段：纠正听错的词，再整段翻译。比逐句翻译准确得多，大约晚 5～10 秒出现，逐句的即时翻译会被替换。只在翻译接口选 DeepSeek / 通义千问时生效。" />

                        <ui:ToggleSwitch
                            Margin="0,12,0,0"
                            Content="中外对照（译文上方保留原文）"
                            IsChecked="{Binding ShowOriginal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ui:ToggleSwitch
                            Margin="0,12,0,0"
                            Content="结合上下文翻译（更准确，多用一些 token）"
                            IsChecked="{Binding ContextAware, Source={x:Static local:Translator.Setting}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ui:ToggleSwitch
                            Margin="0,12,0,0"
                            Content="显示翻译用时"
                            IsChecked="{Binding MainWindow.LatencyShow,
                                        Source={x:Static local:Translator.Setting},
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="翻译频率：字幕每变化" />
                            <Run Text="{Binding MaxSyncInterval, Source={x:Static local:Translator.Setting}, Mode=OneWay}" />
                            <Run Text="次翻译一次" />
                        </TextBlock>
                        <Slider
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            IsSnapToTickEnabled="True"
                            Maximum="10"
                            Minimum="1"
                            TickFrequency="1"
                            Value="{Binding MaxSyncInterval, Source={x:Static local:Translator.Setting}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Hint}" Text="数值越小翻得越及时，调用接口也越频繁。" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Full width: where transcripts are saved  -->
            <Border
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="⑥ 转录保存" />
                    <TextBlock Style="{StaticResource Label}" Text="保存位置" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            x:Name="SaveFolderBox"
                            Grid.Column="0"
                            IsReadOnly="True" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Click="ChooseSaveFolder_click"
                            Content="选择…"
                            Icon="{ui:SymbolIcon FolderOpen16,
                                                 Filled=False}" />
                        <ui:Button
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            Click="OpenSaveFolder_click"
                            Content="打开" />
                        <ui:Button
                            Grid.Column="3"
                            Margin="6,0,0,0"
                            Click="ResetSaveFolder_click"
                            Content="恢复默认" />
                    </Grid>
                    <TextBlock
                        Style="{StaticResource Hint}"
                        Text="每节课点“停止”后，会让你给这节课命名并选择课程，然后保存为“保存位置\课程名\本节课名称.md”，里面有小节总结、原文和译文。历史页里也能按课程查看。改位置只影响之后保存的文件。" />
                    <ui:ToggleSwitch
                        Margin="0,12,0,0"
                        Content="下课后自动生成笔记初稿"
                        IsChecked="{Binding NotesDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Style="{StaticResource Hint}"
                        Text="点“停止”保存后，用 ① 的模型把小节总结、转录和已上传的课件整理成一份笔记初稿（按课件结构，标出课上补充的内容，附复习题），保存为“本节课名称 笔记初稿.md”，和转录文件放在一起。历史页里也可以对任意一节课重新生成。" />
                </StackPanel>
            </Border>

            <!--  Full width: prompt  -->
            <Border
                Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource Card}">
                <Expander Header="高级：总结提示词">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Hint}" Text="{}{0} 会被替换为目标语言。" />
                        <ui:TextBox
                            MinHeight="90"
                            Margin="0,6,0,0"
                            AcceptsReturn="True"
                            Text="{Binding SummaryPrompt, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                            TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Hint}" Text="生成小节总结和笔记时，会自动附加自然表达规则：保留原有事实与结构，避免套话、重复句式和凭空补充细节。" />
                        <ui:Button
                            Margin="0,6,0,0"
                            Click="ResetPrompt_click"
                            Content="恢复默认" />
                    </StackPanel>
                </Expander>
            </Border>

            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="外观" />
                    <TextBlock Style="{StaticResource Label}" Text="主题" />
                    <ComboBox x:Name="ThemeBox" SelectionChanged="ThemeBox_SelectionChanged">
                        <ComboBoxItem Content="跟随系统" Tag="System" />
                        <ComboBoxItem Content="浅色" Tag="Light" />
                        <ComboBoxItem Content="深色" Tag="Dark" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource Label}" Text="界面字号与缩放" />
                    <Slider x:Name="UiScaleSlider" Minimum="0.8" Maximum="1.5" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="UiScaleSlider_ValueChanged" />
                    <TextBlock Style="{StaticResource Hint}" Text="按住 Ctrl 并滚动鼠标滚轮，也可以调整界面字号。" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
